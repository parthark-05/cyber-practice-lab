generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Lab {
  id               String     @id @default(uuid()) @db.Uuid
  slug             String     @unique
  title            String
  description      String
  difficulty       Difficulty
  estimatedMinutes Int
  tags             String[]
  published        Boolean    @default(false)
  createdAt        DateTime   @default(now())
  learnerProgress LearnerProgress[]
  classrooms       Classroom[]

  @@map("labs")
}

model LearnerProgress {
  learnerId   String   @db.Uuid
  labId       String   @db.Uuid
  completedAt DateTime @default(now())
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@id([learnerId, labId])
  @@index([learnerId, completedAt])
  @@map("learner_progress")
}

model Classroom {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(80)
  joinCode  String   @unique @db.VarChar(12)
  facultyId String?  @db.Uuid
  createdAt DateTime @default(now())
  labs      Lab[]
  faculty   FacultyAccount? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  @@index([facultyId, createdAt])

  @@map("classrooms")
}

model StudentAccount {
  id                String           @id @default(uuid()) @db.Uuid
  usn               String           @unique @db.VarChar(20)
  passwordHash      String?          @db.VarChar(256)
  setupCodeHash     String?          @db.VarChar(256)
  setupExpiresAt    DateTime?
  createdAt         DateTime         @default(now())
  sessions          StudentSession[]

  @@map("student_accounts")
}

model StudentSession {
  id        String         @id @default(uuid()) @db.Uuid
  tokenHash String         @unique @db.VarChar(64)
  studentId String         @db.Uuid
  expiresAt DateTime
  createdAt DateTime       @default(now())
  student   StudentAccount @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, expiresAt])
  @@map("student_sessions")
}

model FacultyAccount {
  id             String           @id @default(uuid()) @db.Uuid
  facultyId      String           @unique @db.VarChar(24)
  passwordHash   String?          @db.VarChar(256)
  setupCodeHash  String?          @db.VarChar(256)
  setupExpiresAt DateTime?
  createdAt      DateTime         @default(now())
  sessions       FacultySession[]
  classrooms     Classroom[]

  @@map("faculty_accounts")
}

model FacultySession {
  id        String         @id @default(uuid()) @db.Uuid
  tokenHash String         @unique @db.VarChar(64)
  facultyId String         @db.Uuid
  expiresAt DateTime
  createdAt DateTime       @default(now())
  faculty   FacultyAccount @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId, expiresAt])
  @@map("faculty_sessions")
}
